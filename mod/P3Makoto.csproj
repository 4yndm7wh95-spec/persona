<Project Sdk="Microsoft.NET.Sdk">
  <!--
    编译方法：dotnet build -c Release -p:GameDir="<游戏安装目录>"
    产物：bin/Release/net9.0/P3Makoto.dll
  -->
  <PropertyGroup>
    <AssemblyName>P3Makoto</AssemblyName>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">C:\Users\kkk\Desktop\slaythespire\Slay the Spire 2</GameDir>
    <GameData>$(GameDir)\data_sts2_windows_x86_64</GameData>
    <!-- 只编译 src/ 下的源码：mod/_build/ 等目录里可能残留别的构建产生的 .cs（例如 obj 里的 AssemblyAttributes），不能被编译进来 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameData)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameData)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
