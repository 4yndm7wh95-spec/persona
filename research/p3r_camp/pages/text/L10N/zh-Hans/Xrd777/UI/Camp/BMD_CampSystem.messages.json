    "SYS_SKILLCARD_ALREADY": "[f 0:5 65278][f 2:1 ]已经学会了\r\n[f 0:1 35][f 2:4 0][f 0:1 27]。\r\n[f 1:1 ]",
    "SYS_SKILL_CHANGE": "",
    "SYS_REMEMBER_CONF": "[f 0:5 65278][f 2:1 ]确定要结束吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_NO_EFFECT_INCENSE": "[f 0:5 65278][f 2:1 ]无法继续叠加效果。\r\n[f 1:1 ]",
    "SYS_SYSTEM_BACK_TO_TITLE": "[f 0:5 65278][f 2:1 ]要返回标题画面吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_TITL_USE_NETWORK": "[f 0:5 65278][f 2:1 ][f 1:4 1]若已连接网络，\r\n那么在把网络功能设置为ＯＮ后，\r\n将可在游戏内使用各种功能。\r\n[f 1:5 0]要把网络功能设置为ＯＮ吗？\r\n[f 1:1 ]",
    "SYS_TITL_DONT_USE_NETWOR": "[f 0:5 65278][f 2:1 ]已把网络功能设置为[f 0:1 2]ＯＦＦ[f 0:1 27]。\r\n将在不使用网络功能的情况下继续游戏。\n在ＣＯＮＦＩＧ中可随时更改设置。\n[f 1:1 ]",
    "SYS_SAVE_LOAD_CHECK": "[f 0:5 65278][f 2:1 ]要读取保存数据吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_SAVE_LOAD_OK": "",
    "SYS_SAVE_NETWORK_LOAD": "[f 0:5 65278][f 2:1 ]正在获取在线备份的保存数据。\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_LOAD_OK": "[f 0:5 65278][f 2:1 ]已成功获取\r\n在线备份的保存数据。\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_LOAD_ER": "[f 0:5 65278][f 2:1 ]在线备份的保存数据\r\n获取失败。\r\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_UP": "[f 0:5 65278][f 2:1 ]正在上传保存数据。\r\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_UP_OK": "[f 0:5 65278][f 2:1 ]已成功上传保存数据。\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_UP_ERRO": "[f 0:5 65278][f 2:1 ]保存数据上传失败。\r\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_BROKEN": "[f 0:5 65278][f 2:1 ]在线备份的保存数据\r\n已损坏。\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_INVALID": "[f 0:5 65278][f 2:1 ]网络功能已设置为ＯＦＦ。\n在ＣＯＮＦＩＧ中可更改设置。\n[f 1:1 ]",
    "SYS_SAVE_NETWORK_NOTEXIS": "[f 0:5 65278][f 2:1 ]无网络保存数据。\n[f 1:1 ]",
    "SYS_SAVE_OVERWRITE_CHECK": "[f 0:5 65278][f 2:1 ]已有保存数据。\r\n确定要覆盖吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_SAVE_OK": "",
    "SYS_SAVE_ROLLBACK_CHECK": "[f 0:5 65278][f 2:1 ]若要从选择的数据重新开始，\r\n日期·时间段比选择数据更靠后的数据\n将被删除，确定要继续吗？\n[f 1:4 1][f 1:1 ]",
    "SYS_CONF_CLOSE_CHECK": "[f 0:5 65278][f 2:1 ]不应用设置直接返回吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_CONF_DIFF_CHECK": "[f 0:5 65278][f 2:1 ]若从最高难度更改为其他难度，\n将无法返回原来的难度。\r\n确定要更改吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_CONF_DIFF_CHANGED": "[f 0:5 65278][f 2:1 ]难度已更改为“[f 0:1 2][f 2:4 0][f 0:1 27]”。\n[f 1:1 ]",
    "SYS_CONF_CONNECT_ERROR": "[f 0:5 65278][f 2:1 ]网络连接失败。\r\n[f 1:1 ]",
    "SYS_CONF_CONNECTING": "[f 0:5 65278][f 2:1 ]正在连接网络。\r\n[f 1:1 ]",
    "SYS_PARTY_MEMBEROVER_0_0": "[f 0:5 65278][f 2:1 ]队伍的编成超过了最大人数[f 2:4 0]人。\n[f 1:1 ]",
    "SYS_DIFFICULTY_CHECK": "[f 0:5 65278][f 2:1 ]将以“[f 0:1 2][f 2:4 0][f 0:1 27]”难度开始游戏。\n确定要开始吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_DIFFICULTY_DESC_SAFE": "[f 0:5 65278][f 2:1 ]该难度面向希望专注于故事的玩家。\n[f 1:1 ]",
    "SYS_DIFFICULTY_DESC_EASY": "[f 0:5 65278][f 2:1 ]该难度面向对游戏研究不深的玩家。\n[f 1:1 ]",
    "SYS_DIFFICULTY_DESC_NORM": "[f 0:5 65278][f 2:1 ]该难度面向对游戏有所研究的玩家。\n[f 1:1 ]",
    "SYS_DIFFICULTY_DESC_HARD": "[f 0:5 65278][f 2:1 ]该难度面向希望进一步享受战略的玩家。\n[f 1:1 ]",
    "SYS_DIFFICULTY_DESC_LUNA": "[f 0:5 65278][f 2:1 ]该难度面向真正的顶尖玩家。\r\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_SAFE": "[f 0:5 65278][f 2:1 ]即使在战斗中全灭，也能无限制地当场复活。\n[f 0:1 43]无论选择哪个难度，您的故事都不会有所变化。\r\n另外，也可以之后再更改为\n“LUNATIC”以外的难度。[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_EASY": "[f 0:5 65278][f 2:1 ]和“NORMAL”相比，战斗更简单。\n[f 0:1 43]无论选择哪个难度，您的故事都不会有所变化。\r\n另外，也可以之后再更改为\n“LUNATIC”以外的难度。[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_NORM": "[f 0:5 65278][f 2:1 ]可以在适度的紧张感中享受战斗的乐趣。\n[f 0:1 43]无论选择哪个难度，您的故事都不会有所变化。\r\n另外，也可以之后再更改为\n“LUNATIC”以外的难度。[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_HARD": "[f 0:5 65278][f 2:1 ]和“NORMAL”相比，战斗难度更高。\r\n[f 0:1 43]无论选择哪个难度，您的故事都不会有所变化。\r\n另外，也可以之后再更改为\n“LUNATIC”以外的难度。[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_LUNA": "[f 0:5 65278][f 2:1 ]和“HARD”相比，战斗难度大幅提高。\r\n[f 0:1 43]无论选择哪个难度，您的故事都不会有所变化。[f 0:1 27]\n另外，虽然可以更改为其他难度，\r\n但更改之后无法回到“LUNATIC”。\n[f 1:1 ]",
    "MND_SKILL_NOT_CHANGE": "[f 0:5 65278][f 2:1 ][f 1:5 0][f 1:1 ]",
    "SYS_NETWORK_CONNECT_CHEC": "",
    "SYS_NETWORK_CONNECT_YES": "[f 0:5 65278][f 2:1 ]已把网络功能设置为[f 0:1 2]ＯＮ[f 0:1 27]。\r\n[f 1:5 0]将在启用网络功能的情况下继续游戏。\r\n在ＣＯＮＦＩＧ中可随时更改设置。\n[f 1:1 ]",
    "SYS_NETWORK_CONNECT_NO": "",
    "SYS_NETWORK_VOICE_ERROR": "[f 0:5 65278][f 2:1 ]发生网络错误。\r\n请查看网络连接。\n[f 1:1 ]",
    "MSG_SKILL_CHANGE": "[f 0:5 65278][f 2:1 ]噢……看来技能要发生变化了啊。\r\n要继续见证吗？\r\n[f 1:1 ]",
    "SEL_SKILL_CHANGE": "[f 0:5 65278][f 2:1 ]阻止变化\n[page]\n[f 0:5 65278][f 2:1 ]见证变化\n[page]\n[f 0:5 65278][f 2:1 ]查看技能",
    "SYS_PARTY_FIXED_MEMBER_0": "[f 0:5 65278][f 2:1 ]必须参加队伍的[f 2:4 0]\n未被编入队伍。\r\n[f 1:1 ]",
    "SYS_RECHECK_BACK_TO_TITL": "[f 0:5 65278][f 2:1 ]将失去从上次保存\n直到现在的游戏进度。\n确定要继续吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_GAMEDATA_INSTALL": "[f 0:5 65278][f 2:1 ]正在安装游戏数据。\r\n[f 1:1 ]",
    "SYS_GAMEDATA_INSTALL_OK": "[f 0:5 65278][f 2:1 ]数据已安装完毕。\n[f 1:1 ]",
    "SYS_ACTIVITY_DATA_NOT_MA": "[f 0:5 65278][f 2:1 ]选择的活动和最后记录的\r\n保存数据的条件不一致。\r\n[f 1:5 0]将依照普通的启动方式开始游戏。\r\n[f 1:1 ]",
    "SYS_KEYCONFIG_ASSIGN": "[f 0:5 65278][f 2:1 ]请按下想要\r\n分配至“[f 0:1 35][f 2:4 0][f 0:1 27]”的按键。\r\n[f 1:5 0]按下Ｅｓｃ键可返回设置画面。\n[f 1:1 ]",
    "SYS_KEYCONFIG_OVERWRITE": "[f 0:5 65278][f 2:1 ]更改后的键位和其他键位重复。\n“[f 0:1 2][f 2:4 0][f 0:1 27]”\r\n[f 1:5 0]要用更改后的键位覆盖设置吗？\n[f 1:4 1][f 1:1 ]",
    "SYS_KEYCONFIG_FINISH": "[f 0:5 65278][f 2:1 ]要保存当前设置，完成更改吗？\n[f 1:4 1][f 1:1 ]",
    "SYS_KEYCONFIG_NOT_SET": "[f 0:5 65278][f 2:1 ]还有未完成设置的项目。\r\n[f 1:1 ]",
    "SYS_KEYCONFIG_RESET_KEYB": "[f 0:5 65278][f 2:1 ]将把键盘的键位设置\r\n重置为初始状态。\n确定要重置吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_KEYCONFIG_RESET_MOUS": "[f 0:5 65278][f 2:1 ]将把鼠标的键位设置\r\n重置为初始状态。\n确定要重置吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_KEYCONFIG_RESET_GAME": "[f 0:5 65278][f 2:1 ]将把手柄的键位设置\r\n重置为初始状态。\n确定要重置吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_CONF_DISPLAY_CHECK": "[f 0:5 65278][f 2:1 ]已应用更改后的显示设置。\n要保存当前设置吗？\r\n若无指令输入，将在[f 2:4 0]秒后还原回先前设置。\n[f 1:4 1][f 1:1 ]",
    "SYS_INPUT_DEVICE_LOST": "[f 0:5 65278][f 2:1 ]和设备的连接已断开。\n请查看连接状态。\n[f 1:1 ]",
    "SYS_SAVE_NO_SPACE": "[f 0:5 65278][f 2:1 ]未能正常保存。\r\n请查看存储空间的剩余容量。\r\n[f 1:1 ]",
    "SYS_APP_QUIT": "[f 0:5 65278][f 2:1 ]要退出游戏吗？\r\n[f 1:4 1][f 1:1 ]",
    "SYS_APPLY_INIT_NAME_STOR": "[f 0:5 65278][f 2:1 ]由于语言设置已更改，\n主角的姓名将显示为“结城 理”。\r\n[f 1:5 0]若您希望以开始游戏时设置的姓名游玩，\n则需要将游戏语言改回设置姓名时的语言。\r\n[f 1:1 ]",
    "SYS_APPLY_INIT_NAME_NETW": "[f 0:5 65278][f 2:1 ]由于语言设置有异，\r\n主角的姓名将显示为“结城 理”。\r\n[f 1:5 0]若您希望以开始游戏时设置的姓名游玩，\n则需要将游戏语言改回设置姓名时的语言。\r\n[f 1:1 ]"
