  "messages": {
    "SYS_PERSONA_DROP": "[f 0:5 65278][f 2:1 ]将消灭[f 0:1 35][f 2:4 0][f 0:1 27]。\r\n确定要消灭吗？\r\n[f 1:4 1][f 1:1 ]",
