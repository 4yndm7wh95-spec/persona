{
  "messages": {
    "SYS_DIFFICULTY_CHECK_AST": "[f 0:5 65278][f 2:1 ]Begin the game at [f 0:1 2][f 2:4 0][f 0:1 27] difficulty?\n[f 1:4 1][f 1:1 ]",
    "SYS_DIFFICULTY_INFO_SAFE": "[f 0:5 65278][f 2:1 ]Your party auto-revives after defeat. [f 0:1 43]Your choice of difficulty will not affect the story and can be changed at any time (excluding Heartless).[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_EASY": "[f 0:5 65278][f 2:1 ]Low-stress combat. [f 0:1 43]Your choice of difficulty will not affect the story and can be changed at any time (excluding Heartless).[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_NORM": "[f 0:5 65278][f 2:1 ]Moderately challenging combat. [f 0:1 43]Your choice of difficulty will not affect the story and can be changed at any time (excluding Heartless).[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_HARD": "[f 0:5 65278][f 2:1 ]Significantly challenging combat. [f 0:1 43]Your choice of difficulty will not affect the story and can be changed at any time (excluding Heartless).[f 0:1 27]\n[f 1:1 ]",
    "SYS_DIFFICULTY_INFO_HEAR": "[f 0:5 65278][f 2:1 ]Exceedingly challenging combat. [f 0:1 43]Your choice of difficulty will not affect the story and can be changed at any time, but you cannot return to Heartless once leaving it.\n[f 1:1 ]",
    "SYS_INHERITANCE_LOAD_CHE": "[f 0:5 65278][f 2:1 ]Carry over this data?\n[f 1:5 0][f 1:4 1][f 1:1 ]",
    "SYS_SAVE_VERSION_ERROR": "[f 0:5 65278][f 2:1 ]Unable to resume play. The loaded save data and game version do not match.\n[f 1:1 ]",
    "SYS_SAVE_EPISODE_ERROR": "[f 0:5 65278][f 2:1 ]Unable to resume play. The loaded save data does not match the selected story episode.\n[f 1:1 ]",
    "SYS_VELVETROOM_INFO_INHE": "[f 0:5 65278][f 2:1 ]When summoning from the Compendium, you now have the option to use the one carried over from the main story.\n[f 1:1 ]\n[page]\n[f 0:5 65278][f 2:1 ]Press [f 1:3 118] to switch between the two Compendiums.\n[f 1:1 ]\n[page]\n[f 0:5 65278][f 2:1 ]Summoning from the carried-over Compendium will cost more than usual. You must also be at the same level or higher than the desired Persona.\n[f 1:1 ]",
    "MSG_FLORIST_CHECK": "[f 0:5 65278][f 2:1 ][f 5:21 1,101]Does this look right?\n[f 1:1 ]",
    "SEL_FLORIST_CHECK": "[f 0:5 65278][f 2:1 ]Yes.\n[page]\n[f 0:5 65278][f 2:1 ]Maybe not.",
    "SYS_CONF_DIFF_CHECK_ASTR": "[f 0:5 65278][f 2:1 ]If you reduce the difficulty from the highest level, you won't be able to change it back. Are you sure you want to proceed?\n[f 1:5 0][f 1:4 1][f 1:1 ]"
  },
