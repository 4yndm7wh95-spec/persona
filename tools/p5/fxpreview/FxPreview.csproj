<Project Sdk="Godot.NET.Sdk/4.5.1">
  <!-- 特效预览：直接编译 p5mod/src/Vfx（不引用游戏程序集），在假战斗场景里放特效，录成 GIF。用法见 render.sh -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../p5mod/src/Vfx/**/*.cs" />
    <!-- P3 君王之剑替代的蓝蝶（还没进 P3 mod，见 tools/p3/butterfly） -->
    <Compile Include="../../p3/butterfly/*.cs" />
    <EmbeddedResource Include="../../../p5mod/data/eye_cutin.json" LogicalName="P5Joker.EyeCutIn.json" />
  </ItemGroup>
</Project>
